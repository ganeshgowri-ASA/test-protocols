# Solar PV Testing LIMS-QMS System - Environment Configuration
# =============================================================
# Multi-Platform Support: Railway, Replit, GenSpark, Streamlit Cloud, Local

# ============================================================
# PLATFORM AUTO-DETECTION
# ============================================================
# The application automatically detects the platform based on environment variables.
# No configuration needed - just deploy to your platform of choice!

# Platform-specific env vars (auto-detected, do not set manually):
# - Railway: RAILWAY_ENVIRONMENT, RAILWAY_SERVICE_NAME
# - Replit: REPL_ID, REPL_SLUG
# - GenSpark: GENSPARK_APP_ID, GENSPARK_ENVIRONMENT
# - Streamlit Cloud: Detected via path patterns

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# Option 1: SQLite (default - works everywhere)
# Leave DATABASE_URL unset to use SQLite at data/solar_pv_lims.db

# Option 2: PostgreSQL (Railway, external hosting)
# DATABASE_URL="postgresql://username:password@host:port/database"

# Railway PostgreSQL: Set automatically when you add the PostgreSQL plugin
# POSTGRES_URL or DATABASE_URL will be set by Railway

# GenSpark PostgreSQL:
# GENSPARK_DATABASE_URL="postgresql://username:password@host:port/database"

# ============================================================
# ROLLBACK MECHANISM - CRITICAL FOR PRODUCTION SAFETY
# ============================================================

# Set to "1" to FORCE SQLite fallback, ignoring any PostgreSQL configuration
# This provides instant rollback capability without code changes
# FORCE_SQLITE=1

# ============================================================
# APPLICATION SETTINGS
# ============================================================
APP_NAME="Solar PV Testing LIMS-QMS"
APP_VERSION="1.0.0"
APP_ENV="development"  # development, staging, production

# Database debugging (set to "true" for SQL query logging)
DB_ECHO=false

# ============================================================
# SECURITY
# ============================================================
SESSION_SECRET_KEY="change-me-in-production-use-strong-random-string"
PASSWORD_MIN_LENGTH=8
ENABLE_AUTHENTICATION=true

# ============================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================
# SMTP_SERVER="smtp.gmail.com"
# SMTP_PORT=587
# EMAIL_FROM="noreply@solarpv.com"
# EMAIL_PASSWORD="your-email-password"

# ============================================================
# FILE UPLOAD SETTINGS
# ============================================================
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_TYPES="csv,xlsx,xls,json,pdf,png,jpg,jpeg"

# ============================================================
# TESTING CONFIGURATION
# ============================================================
ENABLE_QA_VALIDATION=true
REQUIRE_SUPERVISOR_APPROVAL=true
AUTO_SAVE_INTERVAL_SECONDS=60
TOTAL_PROTOCOLS=54

# ============================================================
# DATE/TIME FORMATS
# ============================================================
DATE_FORMAT="%Y-%m-%d"
DATETIME_FORMAT="%Y-%m-%d %H:%M:%S"

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================
# DEPLOYMENT
# ============================================================
HOST="0.0.0.0"
PORT=8501

# ============================================================
# STREAMLIT CLOUD USERS
# ============================================================
# For Streamlit Cloud, use .streamlit/secrets.toml instead of .env
# Example secrets.toml:
#
# [database]
# url = "postgresql://user:password@host:port/database"
#
# [general]
# force_sqlite = false
